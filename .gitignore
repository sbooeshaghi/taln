# Frozen revision summaries: every number in the manuscript traces to these.
# Per-record outputs (hundreds of MB) stay ignored; summaries, tables, run
# configs, run metadata, and sample manifests are tracked.
!data/revision_2026/
!data/revision_2026/**/
!data/revision_2026/**/*.tsv
!data/revision_2026/**/*summary*.json
!data/revision_2026/**/*metadata*.json
!data/revision_2026/**/*config*.json
!data/revision_2026/**/*manifest*.json
!data/revision_2026/**/*ledger*.json
data/revision_2026/stage3/
data/revision_2026/**/*records*
